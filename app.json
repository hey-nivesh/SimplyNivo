{
  "expo": {
    "name": "SimplyNivo",
    "slug": "simplynivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0813",
    "scheme": "simplynivo",
    "splash": {
      "image": "./assets/expo.icon/Assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0813"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simplynivo.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SimplyNivo requires microphone access to record your voice and simplify your situations."
      }
    },
    "android": {
      "package": "com.simplynivo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo.icon/Assets/logo.png",
        "backgroundColor": "#0A0813"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/expo.icon/Assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0813",
          "image": "./assets/expo.icon/Assets/logo.png",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "SimplyNivo needs access to your microphone so you can explain your situations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "67c5dbc4-3acd-48b2-8259-af78063bc33b"
      }
    },
    "owner": "nivesh007"
  }
}
