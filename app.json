{
  "expo": {
    "name": "SimplyNivo",
    "slug": "simplynivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0813",
    "scheme": "simplynivo",
    "splash": {
      "image": "./assets/expo.icon/Assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0813"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simplynivo.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SimplyNivo requires microphone access to record your voice and simplify your situations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo.icon/Assets/logo.png",
        "backgroundColor": "#0A0813"
      },
      "package": "com.simplynivo.app",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/expo.icon/Assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0813",
          "image": "./assets/expo.icon/Assets/logo.png",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
