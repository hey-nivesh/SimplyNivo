{
  "expo": {
    "name": "SimplyNivo",
    "slug": "simplynivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0813",
    "scheme": "simplynivo",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simplynivo.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SimplyNivo requires microphone access to record your voice and simplify your situations."
      }
    },
    "android": {
      "package": "com.simplynivo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A0813"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0813",
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "SimplyNivo needs access to your microphone so you can explain your situations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-dontwarn expo.modules.**\n-dontwarn expo.modules.core.**\n-dontwarn expo.modules.av.**\n-keep class com.facebook.react.** { *; }\n-dontwarn com.facebook.react.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "67c5dbc4-3acd-48b2-8259-af78063bc33b"
      }
    },
    "owner": "nivesh007"
  }
}
